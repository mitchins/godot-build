# build outputs
/build/
*.o
*.a
*.dylib
*.dSYM/
.sconsign.dblite

# Godot
# The committed .gdextension source is extension/fauxbuild.gdextension; the build
# installs a copy plus the binaries into godot/bin/, which are generated artifacts.
.godot/
godot/bin/*.dylib
godot/bin/*.a
godot/bin/fauxbuild.gdextension
godot/bin/fauxbuild.gdextension.uid

# proprietary local stress data (plan §4.4) — never commit
/local_reference/

# generated fixtures are reproducible outputs of tools, never hand-edited
/fixtures/generated/*
!/fixtures/generated/.gitkeep

# OS noise
.DS_Store

# Python bytecode (ci/ scripts are imported by tests/fuzz/gen_manifest.py)
__pycache__/
*.pyc
